<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:EdidEditor.Theme.Light.Behaviors"
    xmlns:converters="clr-namespace:EdidEditor.Theme.Light.Converters"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:styles="clr-namespace:EdidEditor.Theme.Light.Helpers">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
        <ResourceDictionary Source="Styles.RepeatButton.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="Brush.Gray.1" Color="{StaticResource Color.Gray.1}" />

    <!--  为ScrollViewer默认样式设计的ScrollBar样式，也可以单独使用  -->
    <Style x:Key="Style.ScrollBar.Default" TargetType="ScrollBar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="RootGrid">
                        <Grid.Resources>
                            <converters:SolidColorBrushLerpConverter x:Key="SolidColorBrushLerpConverter" />
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                        </Grid.RowDefinitions>
                        <RepeatButton
                            Grid.Row="0"
                            Command="ScrollBar.LineUpCommand"
                            Style="{StaticResource Style.RepeatButton.Arrow.Up}" />

                        <Border Grid.Row="1" Background="{StaticResource Brush.Gray.1}">
                            <Track
                                x:Name="PART_Track"
                                Margin="{TemplateBinding Padding}"
                                IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="PageUpRepeatButton" Command="ScrollBar.PageUpCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="PageDownRepeatButton" Command="ScrollBar.PageDownCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Border CornerRadius="{Binding Path=(styles:AttachedProperties.CornerRadius), RelativeSource={RelativeSource AncestorType=ScrollBar}}">
                                                        <Border.Resources>
                                                            <SolidColorBrush
                                                                x:Key="ScrollBarBackgroundNormal"
                                                                Opacity="0.2"
                                                                Color="{StaticResource Color.Gray.6}" />
                                                            <SolidColorBrush
                                                                x:Key="ScrollBarBackgroundPressed"
                                                                Opacity="0.4"
                                                                Color="{StaticResource Color.Gray.6}" />
                                                        </Border.Resources>
                                                        <Border.Background>
                                                            <MultiBinding Converter="{StaticResource SolidColorBrushLerpConverter}">
                                                                <Binding Source="{StaticResource ScrollBarBackgroundNormal}" />
                                                                <Binding Source="{StaticResource ScrollBarBackgroundPressed}" />
                                                                <Binding Path="(styles:AttachedProperties.AnimationProgress)" RelativeSource="{RelativeSource AncestorType=ScrollBar}" />
                                                            </MultiBinding>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>

                        <RepeatButton
                            Grid.Row="2"
                            Command="ScrollBar.LineDownCommand"
                            Style="{StaticResource Style.RepeatButton.Arrow.Down}" />

                        <!--  与ScrollViewer内容区域重合的滚动条存在无法触摸滑动的问题，这里通过滚动条被拖拽时自动关闭所有父级ScrollViewer的内容滑动来解决  -->
                        <i:Interaction.Behaviors>
                            <behaviors:FixScrollViewerBarTouchBehavior />
                        </i:Interaction.Behaviors>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  鼠标悬停时播放加深动画  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(styles:AttachedProperties.AnimationProgress)"
                                            To="1"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(styles:AttachedProperties.AnimationProgress)"
                                            To="0"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!--  滚动时播放加深动画  -->
                        <EventTrigger RoutedEvent="ScrollBar.ValueChanged">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="(styles:AttachedProperties.AnimationProgress)"
                                        To="1"
                                        Duration="0:0:0.2" />
                                    <DoubleAnimation
                                        BeginTime="0:0:0.2"
                                        Storyboard.TargetProperty="(styles:AttachedProperties.AnimationProgress)"
                                        To="0"
                                        Duration="0:0:0.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <!--  当方向为水平时，修改一些属性使得滚动条旋转为水平  -->
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="RootGrid" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="PART_Track" Property="Orientation" Value="Vertical" />
                            <Setter TargetName="PageUpRepeatButton" Property="Command" Value="ScrollBar.PageLeftCommand" />
                            <Setter TargetName="PageDownRepeatButton" Property="Command" Value="ScrollBar.PageRightCommand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>