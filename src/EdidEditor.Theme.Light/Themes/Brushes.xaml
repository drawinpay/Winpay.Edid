<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  主题色  -->
    <SolidColorBrush x:Key="Brush.Normal" Color="{StaticResource Color.Gray.6}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Gray.5}" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="{StaticResource Color.Gray.7}" />

    <!--  文本色  -->
    <SolidColorBrush x:Key="Brush.Foreground.Normal" Color="{StaticResource Color.Gray.10}" />
    <SolidColorBrush x:Key="Brush.Foreground.Hover" Color="{StaticResource Color.Gray.7}" />
    <SolidColorBrush x:Key="Brush.Foreground.Pressed" Color="{StaticResource Color.Gray.8}" />
    <SolidColorBrush x:Key="Brush.Foreground.Subtitle" Color="{StaticResource Color.Gray.5}" />
    <SolidColorBrush x:Key="Brush.Foreground.Highlight" Color="{StaticResource Color.White}" />
    <SolidColorBrush x:Key="Brush.Foreground.Information" Color="{StaticResource Color.Gray.2}" />
    <SolidColorBrush x:Key="Brush.Foreground.Warning" Color="{StaticResource Color.Yellow.7}" />
    <SolidColorBrush x:Key="Brush.Foreground.Error" Color="{StaticResource Color.Red.7}" />

    <SolidColorBrush x:Key="Brush.Foreground.Hint.Normal" Color="{StaticResource Color.Gray.2}" />
    <SolidColorBrush x:Key="Brush.Foreground.Hint.Hover" Color="{StaticResource Color.Gray.2}" />
    <SolidColorBrush x:Key="Brush.Foreground.Hint.Pressed" Color="{StaticResource Color.White}" />

    <!--  边框色  -->
    <SolidColorBrush x:Key="Brush.Border.Normal" Color="{StaticResource Color.Gray.2}" />
    <SolidColorBrush x:Key="Brush.Border.Hover" Color="{StaticResource Color.Gray.2}" />
    <SolidColorBrush x:Key="Brush.Border.Pressed" Color="{StaticResource Color.White}" />
    <SolidColorBrush x:Key="Brush.Border.Warning" Color="{StaticResource Color.Yellow.6}" />
    <SolidColorBrush x:Key="Brush.Border.Error" Color="{StaticResource Color.Red.6}" />

    <!--  背景色  -->
    <SolidColorBrush x:Key="Brush.Background.Content" Color="{StaticResource Color.White}" />
    <SolidColorBrush x:Key="Brush.Background.Normal" Color="{StaticResource Color.Gray.1}" />
    <SolidColorBrush x:Key="Brush.Background.Hover" Color="{StaticResource Color.Gray.3}" />
    <SolidColorBrush x:Key="Brush.Background.Pressed" Color="{StaticResource Color.Gray.4}" />
    <SolidColorBrush x:Key="Brush.Background.Selected" Color="{StaticResource Color.Gray.4}" />

    <SolidColorBrush
        x:Key="Brush.Background.Watermark.Normal"
        Opacity="0.2"
        Color="{StaticResource Color.Gray.1}" />
    <SolidColorBrush
        x:Key="Brush.Background.Watermark.Hover"
        Opacity="0.35"
        Color="{StaticResource Color.Gray.1}" />
    <SolidColorBrush
        x:Key="Brush.Background.Watermark.Pressed"
        Opacity="0.5"
        Color="{StaticResource Color.Gray.1}" />

    <SolidColorBrush
        x:Key="Brush.Background.Translucent"
        Opacity="0.4"
        Color="Black" />
    <SolidColorBrush
        x:Key="Brush.Background.Translucent.6"
        Opacity="0.6"
        Color="Black" />
    <SolidColorBrush x:Key="Brush.Background.PureText.Pressed" Color="{StaticResource Color.InkBlue.1}" />
</ResourceDictionary>