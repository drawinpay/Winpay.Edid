<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:EdidEditor.Theme.Light.Converters"
    xmlns:helpers="clr-namespace:EdidEditor.Theme.Light.Helpers">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brushes.xaml" />
        <ResourceDictionary Source="Styles.ScrollBar.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="ScrollViewer.Base" TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <!--  以下两项令滚动查看器支持触摸滑动  -->
        <Setter Property="IsManipulationEnabled" Value="True" />
        <Setter Property="PanningMode" Value="Both" />
    </Style>

    <!--  默认滚动容器  -->
    <Style
        x:Key="Style.ScrollViewer.Default"
        BasedOn="{StaticResource ScrollViewer.Base}"
        TargetType="ScrollViewer">
        <Style.Resources>
            <converters:NumberRateConverter x:Key="NumberRateConverter" />
        </Style.Resources>
        <Setter Property="helpers:AttachedProperties.BarThickness" Value="6" />
        <Setter Property="helpers:AttachedProperties.VerticalScrollBarMargin" Value="8" />
        <Setter Property="helpers:AttachedProperties.HorizontalScrollBarMargin" Value="8" />
        <Setter Property="helpers:AttachedProperties.CornerRadius" Value="{Binding Path=(helpers:AttachedProperties.BarThickness), RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource NumberRateConverter}, ConverterParameter=0.5}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{Binding Path=(helpers:AttachedProperties.CornerRadius), RelativeSource={RelativeSource Mode=TemplatedParent}}">
                        <Grid>
                            <ScrollContentPresenter />
                            <ScrollBar
                                x:Name="PART_VerticalScrollBar"
                                Width="{Binding Path=(helpers:AttachedProperties.BarThickness), RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                MinWidth="0"
                                Margin="{Binding Path=(helpers:AttachedProperties.VerticalScrollBarMargin), RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                HorizontalAlignment="Right"
                                helpers:AttachedProperties.CornerRadius="{Binding Path=(helpers:AttachedProperties.CornerRadius), RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                Maximum="{TemplateBinding ScrollableHeight}"
                                Minimum="0"
                                Orientation="Vertical"
                                Style="{StaticResource Style.ScrollBar.Default}"
                                ViewportSize="{TemplateBinding ViewportHeight}"
                                Value="{TemplateBinding VerticalOffset}" />
                            <ScrollBar
                                x:Name="PART_HorizontalScrollBar"
                                Height="{Binding Path=(helpers:AttachedProperties.BarThickness), RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                MinHeight="0"
                                Margin="{Binding Path=(helpers:AttachedProperties.HorizontalScrollBarMargin), RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                VerticalAlignment="Bottom"
                                helpers:AttachedProperties.CornerRadius="{Binding Path=(helpers:AttachedProperties.CornerRadius), RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                Maximum="{TemplateBinding ScrollableWidth}"
                                Minimum="0"
                                Orientation="Horizontal"
                                Style="{StaticResource Style.ScrollBar.Default}"
                                ViewportSize="{TemplateBinding ViewportWidth}"
                                Value="{TemplateBinding HorizontalOffset}" />
                        </Grid>
                    </Border>
                    <!--  绑定滚动条可见性  -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="VerticalScrollBarVisibility" Value="Auto">
                            <Setter TargetName="PART_VerticalScrollBar" Property="Visibility" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ComputedVerticalScrollBarVisibility}" />
                        </Trigger>
                        <Trigger Property="VerticalScrollBarVisibility" Value="Disabled">
                            <Setter TargetName="PART_VerticalScrollBar" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="VerticalScrollBarVisibility" Value="Hidden">
                            <Setter TargetName="PART_VerticalScrollBar" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="VerticalScrollBarVisibility" Value="Visible">
                            <Setter TargetName="PART_VerticalScrollBar" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HorizontalScrollBarVisibility" Value="Auto">
                            <Setter TargetName="PART_HorizontalScrollBar" Property="Visibility" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ComputedHorizontalScrollBarVisibility}" />
                        </Trigger>
                        <Trigger Property="HorizontalScrollBarVisibility" Value="Disabled">
                            <Setter TargetName="PART_HorizontalScrollBar" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HorizontalScrollBarVisibility" Value="Hidden">
                            <Setter TargetName="PART_HorizontalScrollBar" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="HorizontalScrollBarVisibility" Value="Visible">
                            <Setter TargetName="PART_HorizontalScrollBar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Default ScrollViewer Style  -->
    <Style BasedOn="{StaticResource ScrollViewer.Base}" TargetType="ScrollViewer" />

</ResourceDictionary>