<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:att="clr-namespace:EdidEditor.Theme.Light.Helpers"
    xmlns:converters="clr-namespace:EdidEditor.Theme.Light.Converters">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brushes.xaml" />
        <ResourceDictionary Source="Fonts.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="RadioButton.Base" TargetType="RadioButton">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.YaHei}" />
    </Style>

    <Style
        x:Key="Style.RadioButton.Default"
        BasedOn="{StaticResource RadioButton.Base}"
        TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Brush.Foreground.Normal}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="att:AttachedProperties.ThumbSize" Value="16" />
        <Setter Property="att:AttachedProperties.TextMargin" Value="6 0 0 0" />
        <Setter Property="FontSize" Value="12" />
        <!--  未选中  -->
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Normal}" />
        <Setter Property="att:AttachedProperties.BorderBrushNormal" Value="{Binding Path=BorderBrush, RelativeSource={RelativeSource Mode=Self}}" />
        <Setter Property="att:AttachedProperties.BorderBrushHover" Value="{Binding Path=(att:AttachedProperties.BorderBrushNormal), RelativeSource={RelativeSource Mode=Self}}" />
        <Setter Property="att:AttachedProperties.BorderBrushPressed" Value="{Binding Path=(att:AttachedProperties.BorderBrushNormal), RelativeSource={RelativeSource Mode=Self}}" />
        <!--  选中  -->
        <Setter Property="att:AttachedProperties.BorderBrushChecked" Value="{StaticResource Brush.Border.Normal}" />
        <Setter Property="att:AttachedProperties.BorderBrushCheckedHover" Value="{Binding Path=(att:AttachedProperties.BorderBrushChecked), RelativeSource={RelativeSource Mode=Self}}" />
        <Setter Property="att:AttachedProperties.BorderBrushCheckedPressed" Value="{Binding Path=(att:AttachedProperties.BorderBrushChecked), RelativeSource={RelativeSource Mode=Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal">
                        <Grid VerticalAlignment="Center">
                            <Grid.Resources>
                                <converters:ThicknessToDoubleConverter x:Key="ThicknessToDoubleConverter" />
                                <converters:NumberRateConverter x:Key="NumberRateConverter" />
                            </Grid.Resources>
                            <Ellipse
                                x:Name="OuterEllipse"
                                Width="{Binding Path=(att:AttachedProperties.ThumbSize), RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                Height="{Binding Path=(att:AttachedProperties.ThumbSize), RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                VerticalAlignment="Center"
                                Fill="{TemplateBinding Background}"
                                Stroke="{Binding Path=(att:AttachedProperties.BorderBrushNormal), RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                StrokeThickness="{Binding Path=BorderThickness, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource ThicknessToDoubleConverter}}" />
                            <Ellipse
                                x:Name="InnerEllipse"
                                Width="{Binding Path=(att:AttachedProperties.ThumbSize), RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource NumberRateConverter}, ConverterParameter=0.6}"
                                Height="{Binding Path=(att:AttachedProperties.ThumbSize), RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource NumberRateConverter}, ConverterParameter=0.6}"
                                VerticalAlignment="Center"
                                StrokeThickness="0"
                                Visibility="Hidden" />
                        </Grid>
                        <TextBlock
                            x:Name="ContentTextBlock"
                            Margin="{Binding Path=(att:AttachedProperties.TextMargin), RelativeSource={RelativeSource Mode=TemplatedParent}}"
                            VerticalAlignment="Center"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}"
                            Text="{TemplateBinding Content}"
                            Visibility="{TemplateBinding Content,
                                                         Converter={x:Static converters:EmptyOrNullToVisibilities.CollapsedWhenEmptyOrNull}}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <!--  未选中态  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="OuterEllipse" Property="Stroke" Value="{Binding Path=(att:AttachedProperties.BorderBrushHover), RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="OuterEllipse" Property="Stroke" Value="{Binding Path=(att:AttachedProperties.BorderBrushPressed), RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                        </MultiTrigger>
                        <!--  选中态  -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="InnerEllipse" Property="Visibility" Value="Visible" />
                            <Setter TargetName="InnerEllipse" Property="Fill" Value="{Binding Path=(att:AttachedProperties.BorderBrushChecked), RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                            <Setter TargetName="OuterEllipse" Property="Stroke" Value="{Binding Path=(att:AttachedProperties.BorderBrushChecked), RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="InnerEllipse" Property="Visibility" Value="Visible" />
                            <Setter TargetName="InnerEllipse" Property="Fill" Value="{Binding Path=(att:AttachedProperties.BorderBrushCheckedHover), RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                            <Setter TargetName="OuterEllipse" Property="Stroke" Value="{Binding Path=(att:AttachedProperties.BorderBrushCheckedHover), RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="InnerEllipse" Property="Visibility" Value="Visible" />
                            <Setter TargetName="InnerEllipse" Property="Fill" Value="{Binding Path=(att:AttachedProperties.BorderBrushCheckedPressed), RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                            <Setter TargetName="OuterEllipse" Property="Stroke" Value="{Binding Path=(att:AttachedProperties.BorderBrushCheckedPressed), RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  图片单选互斥按钮  -->
    <Style
        x:Key="Style.RadioButton.Image"
        BasedOn="{StaticResource RadioButton.Base}"
        TargetType="RadioButton">
        <Setter Property="att:AttachedProperties.ImageNormal" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="att:AttachedProperties.ImagePressed" Value="{Binding Path=(att:AttachedProperties.ImageNormal), RelativeSource={RelativeSource Self}}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="att:AttachedProperties.CornerRadius" Value="0" />
        <Setter Property="att:AttachedProperties.BackgroundNormal" Value="{Binding Path=Background, RelativeSource={RelativeSource Self}}" />
        <Setter Property="att:AttachedProperties.BackgroundHover" Value="{Binding Path=(att:AttachedProperties.BackgroundNormal), RelativeSource={RelativeSource Self}}" />
        <Setter Property="att:AttachedProperties.BackgroundPressed" Value="{Binding Path=(att:AttachedProperties.BackgroundNormal), RelativeSource={RelativeSource Self}}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="att:AttachedProperties.BorderBrushNormal" Value="{Binding Path=BorderBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="att:AttachedProperties.BorderBrushHover" Value="{Binding Path=(att:AttachedProperties.BorderBrushNormal), RelativeSource={RelativeSource Self}}" />
        <Setter Property="att:AttachedProperties.BorderBrushPressed" Value="{Binding Path=(att:AttachedProperties.BorderBrushNormal), RelativeSource={RelativeSource Self}}" />


        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="CoverBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(att:AttachedProperties.BackgroundNormal)}"
                        BorderBrush="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(att:AttachedProperties.BorderBrushNormal)}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(att:AttachedProperties.CornerRadius)}"
                        Opacity="{TemplateBinding Opacity}">

                        <Image
                            x:Name="image"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            Source="{Binding Path=(att:AttachedProperties.ImageNormal), RelativeSource={RelativeSource TemplatedParent}}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CoverBorder" Property="Opacity" Value="1" />
                            <Setter TargetName="CoverBorder" Property="Background" Value="{Binding Path=(att:AttachedProperties.BackgroundHover), RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="CoverBorder" Property="BorderBrush" Value="{Binding Path=(att:AttachedProperties.BorderBrushHover), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CoverBorder" Property="Opacity" Value="1" />
                            <Setter TargetName="image" Property="Source" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(att:AttachedProperties.ImagePressed)}" />
                            <Setter TargetName="CoverBorder" Property="Background" Value="{Binding Path=(att:AttachedProperties.BackgroundPressed), RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="CoverBorder" Property="BorderBrush" Value="{Binding Path=(att:AttachedProperties.BorderBrushPressed), RelativeSource={RelativeSource TemplatedParent}}" />

                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CoverBorder" Property="Opacity" Value="1" />
                            <Setter TargetName="image" Property="Source" Value="{Binding Path=(att:AttachedProperties.ImagePressed), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>