<UserControl
    x:Class="EdidEditor.Views.RawEdidDataView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="clr-namespace:EdidEditor.Views.Models"
    xmlns:properties="clr-namespace:EdidEditor.Properties"
    xmlns:view="clr-namespace:EdidEditor.Views">

    <UserControl.DataContext>
        <view:RawEdidDataViewModel />
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBox
            Margin="0,0,0,2"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            FontSize="{StaticResource FontSize.Header1}"
            Style="{StaticResource Style.TextBox.TextBlock}"
            Text="{x:Static properties:Resources.Header_RawData}" />

        <Grid Grid.Row="1" Background="{StaticResource Brush.Background.Content}">
            <ListBox
                Margin="2,2,0,0"
                Background="Transparent"
                ItemContainerStyle="{StaticResource Style.ListBoxItem.None}"
                ItemsSource="{Binding Blocks}"
                ScrollViewer.CanContentScroll="False"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Style="{StaticResource Style.ListBox.Default}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,2">
                            <ListBox
                                Background="Transparent"
                                BorderThickness="0"
                                FontFamily="Consolas"
                                FontSize="{StaticResource FontSize.Content}"
                                IsHitTestVisible="False"
                                ItemsSource="{Binding}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>

                                <ListBox.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource Style.ListBoxItem.None}" TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Margin" Value="0,0,1,1" />
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type model:ByteModel}">
                                        <Border
                                            x:Name="bd"
                                            Background="{StaticResource Brush.Background.Normal}"
                                            BorderBrush="{StaticResource Brush.Border.Normal}"
                                            BorderThickness="1">
                                            <Grid Width="24" Height="24">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                </Grid.RowDefinitions>
                                                <TextBlock
                                                    x:Name="tbIndex"
                                                    Grid.Row="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="{StaticResource FontSize.10}"
                                                    Foreground="{StaticResource Brush.Foreground.Information}"
                                                    Text="{Binding Index}" />
                                                <TextBlock
                                                    x:Name="tbValue"
                                                    Grid.Row="1"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="{StaticResource FontSize.10}"
                                                    Text="{Binding HexValue}"
                                                    TextAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Background.Selected}" />
                                                <Setter TargetName="tbValue" Property="Foreground" Value="{StaticResource Brush.Foreground.Highlight}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>