<UserControl
    x:Class="EdidEditor.Views.ColorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:EdidEditor.Views.Common"
    xmlns:properties="clr-namespace:EdidEditor.Properties"
    xmlns:view="clr-namespace:EdidEditor.Views">

    <UserControl.DataContext>
        <view:ColorViewModel />
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <common:PrimaryTitle Title="{x:Static properties:Resources.Color_PrimaryTitle}" Margin="0,0,20,0" />
        <Grid Grid.Row="1" Margin="10,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Style="{StaticResource SectionLabelStyle}"
                Text="Red x:" />
            <TextBox
                Grid.Row="0"
                Grid.Column="1"
                Text="{Binding RedX, Mode=OneWay}" />

            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Style="{StaticResource SectionLabelStyle}"
                Text="Red y:" />
            <TextBox
                Grid.Row="1"
                Grid.Column="1"
                Text="{Binding RedY, Mode=OneWay}" />

            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                Style="{StaticResource SectionLabelStyle}"
                Text="Green x:" />
            <TextBox
                Grid.Row="2"
                Grid.Column="1"
                Text="{Binding GreenX, Mode=OneWay}" />

            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                Style="{StaticResource SectionLabelStyle}"
                Text="Green y:" />
            <TextBox
                Grid.Row="3"
                Grid.Column="1"
                Text="{Binding GreenY, Mode=OneWay}" />

            <TextBlock
                Grid.Row="4"
                Grid.Column="0"
                Style="{StaticResource SectionLabelStyle}"
                Text="Blue x:" />
            <TextBox
                Grid.Row="4"
                Grid.Column="1"
                Text="{Binding BlueX, Mode=OneWay}" />

            <TextBlock
                Grid.Row="5"
                Grid.Column="0"
                Style="{StaticResource SectionLabelStyle}"
                Text="Blue y:" />
            <TextBox
                Grid.Row="5"
                Grid.Column="1"
                Text="{Binding BlueY, Mode=OneWay}" />

            <TextBlock
                Grid.Row="6"
                Grid.Column="0"
                Style="{StaticResource SectionLabelStyle}"
                Text="White x:" />
            <TextBox
                Grid.Row="6"
                Grid.Column="1"
                Text="{Binding WhiteX, Mode=OneWay}" />

            <TextBlock
                Grid.Row="7"
                Grid.Column="0"
                Style="{StaticResource SectionLabelStyle}"
                Text="White y:" />
            <TextBox
                Grid.Row="7"
                Grid.Column="1"
                Text="{Binding WhiteY, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>