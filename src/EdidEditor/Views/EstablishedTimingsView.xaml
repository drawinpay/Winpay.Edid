<UserControl
    x:Class="EdidEditor.Views.EstablishedTimingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:EdidEditor.Views.Common"
    xmlns:properties="clr-namespace:EdidEditor.Properties"
    xmlns:view="clr-namespace:EdidEditor.Views">

    <UserControl.DataContext>
        <view:EstablishedTimingsViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="EstablishedTimingListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <DataTemplate x:Key="EstablishedTimingItemTemplate">
            <CheckBox
                Content="{Binding Text}"
                IsChecked="{Binding IsEnabled, Mode=OneWay}"
                IsEnabled="False" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <common:PrimaryTitle
                Title="{x:Static properties:Resources.EstablishedTimings_1}"
                Grid.Row="0"
                Margin="0,0,20,0" />

            <ListBox
                Grid.Row="1"
                BorderThickness="0"
                ItemContainerStyle="{StaticResource EstablishedTimingListBoxItemStyle}"
                ItemTemplate="{StaticResource EstablishedTimingItemTemplate}"
                ItemsSource="{Binding EstablishedTimings1}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <common:PrimaryTitle
                Title="{x:Static properties:Resources.EstablishedTimings_2}"
                Grid.Row="0"
                Margin="0,0,20,0" />

            <ListBox
                Grid.Row="1"
                BorderThickness="0"
                ItemContainerStyle="{StaticResource EstablishedTimingListBoxItemStyle}"
                ItemTemplate="{StaticResource EstablishedTimingItemTemplate}"
                ItemsSource="{Binding EstablishedTimings2}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <common:PrimaryTitle
                Title="{x:Static properties:Resources.EstablishedTimings_Manufacturer}"
                Grid.Row="0"
                Margin="0,0,20,0" />

            <ListBox
                Grid.Row="1"
                BorderThickness="0"
                ItemContainerStyle="{StaticResource EstablishedTimingListBoxItemStyle}"
                ItemTemplate="{StaticResource EstablishedTimingItemTemplate}"
                ItemsSource="{Binding ManufacturerTimings}" />
        </Grid>
    </Grid>
</UserControl>