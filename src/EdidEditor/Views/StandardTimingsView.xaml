<UserControl
    x:Class="EdidEditor.Views.StandardTimingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <GroupBox Header="Standard Timings">
            <Grid Margin="12">
                <ListBox
                    x:Name="LsbStandardTimings"
                    MinHeight="400"
                    Background="Transparent"
                    BorderThickness="0"
                    IsHitTestVisible="False">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,12" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="12"
                                Background="White"
                                BorderBrush="#D0D0D0"
                                BorderThickness="1">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}" />

                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontSize="13"
                                        Text="Unused">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUnused}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUnused}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Style="{StaticResource SectionLabelStyle}"
                                            Text="X resolution:" />
                                        <TextBox
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Width="120"
                                            HorizontalAlignment="Left"
                                            Text="{Binding Width, Mode=OneWay}" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Style="{StaticResource SectionLabelStyle}"
                                            Text="X:Y pixel ratio :" />
                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Orientation="Horizontal">
                                            <RadioButton
                                                Margin="0,0,12,0"
                                                Content="00=16:10"
                                                IsChecked="{Binding IsAspectRatio16By10, Mode=OneWay}"
                                                IsEnabled="False" />
                                            <RadioButton
                                                Margin="0,0,12,0"
                                                Content="01=4:3"
                                                IsChecked="{Binding IsAspectRatio4By3, Mode=OneWay}"
                                                IsEnabled="False" />
                                            <RadioButton
                                                Margin="0,0,12,0"
                                                Content="10=5:4"
                                                IsChecked="{Binding IsAspectRatio5By4, Mode=OneWay}"
                                                IsEnabled="False" />
                                            <RadioButton
                                                Content="11=16:9"
                                                IsChecked="{Binding IsAspectRatio16By9, Mode=OneWay}"
                                                IsEnabled="False" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Style="{StaticResource SectionLabelStyle}"
                                            Text="Vertical frequency:" />
                                        <TextBox
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Width="120"
                                            HorizontalAlignment="Left"
                                            Text="{Binding Frequency, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </GroupBox>
    </StackPanel>
</UserControl>