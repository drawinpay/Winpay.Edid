<UserControl
    x:Class="EdidEditor.Views.GeneralInfoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:EdidEditor.Views.Common"
    xmlns:properties="clr-namespace:EdidEditor.Properties"
    xmlns:view="clr-namespace:EdidEditor.Views">

    <UserControl.DataContext>
        <view:GeneralInfoViewModel />
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <common:PrimaryTitle
                Grid.Row="0"
                Margin="0,0,20,0"
                Title="{x:Static properties:Resources.ProductInfo_PrimaryTitle}"
                Tips="{x:Static properties:Resources.ProductInfo_TitleTips}" />

            <Grid Grid.Row="1" Margin="10,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource SectionLabelStyle}"
                    Text="{x:Static properties:Resources.ProductInfo_Label_ManufacturerName}" />
                <TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="120"
                    HorizontalAlignment="Left"
                    Text="{Binding ManufacturerName, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource SectionLabelStyle}"
                    Text="{x:Static properties:Resources.ProductInfo_Label_ProductCode}" />
                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Width="120"
                    HorizontalAlignment="Left"
                    Text="{Binding ProductCode, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Style="{StaticResource SectionLabelStyle}"
                    Text="{x:Static properties:Resources.ProductInfo_Label_SerialNumber}" />
                <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Width="120"
                    HorizontalAlignment="Left"
                    Text="{Binding SerialNumber, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Style="{StaticResource SectionLabelStyle}"
                    Text="{x:Static properties:Resources.ProductInfo_Label_ManufacturerWeek}" />
                <TextBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Width="120"
                    HorizontalAlignment="Left"
                    Text="{Binding WeekOfManufacture, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    Style="{StaticResource SectionLabelStyle}"
                    Text="{x:Static properties:Resources.ProductInfo_Label_ManufacturerYear}" />
                <TextBox
                    Grid.Row="4"
                    Grid.Column="1"
                    Width="120"
                    HorizontalAlignment="Left"
                    Text="{Binding YearOfManufacture, Mode=OneWay}" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <common:PrimaryTitle
                Grid.Row="0"
                Margin="0,0,20,0"
                Title="{x:Static properties:Resources.Version_PrimaryTitle}"
                Tips="{x:Static properties:Resources.Version_TitleTips}" />

            <Grid Grid.Row="1" Margin="10,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource SectionLabelStyle}"
                    Text="{x:Static properties:Resources.Version_Label_Version}" />
                <TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="120"
                    HorizontalAlignment="Left"
                    Text="{Binding Version, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource SectionLabelStyle}"
                    Text="{x:Static properties:Resources.Version_Label_Revision}" />
                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Width="120"
                    HorizontalAlignment="Left"
                    Text="{Binding Revision, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>