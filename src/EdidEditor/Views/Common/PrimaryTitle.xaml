<UserControl
    x:Class="EdidEditor.Views.Common.PrimaryTitle"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Height="40" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBlock
            Grid.Row="0"
            Margin="2,7"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            FontSize="{StaticResource FontSize.Title}"
            Text="{Binding Title, ElementName=root}" />

        <TextBlock
            Grid.Column="1"
            Margin="10,7"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            FontSize="{StaticResource FontSize.SubTitle}"
            Foreground="{StaticResource Brush.Foreground.Subtitle}"
            Text="{Binding Tips, ElementName=root}" />

        <Border
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Height="1"
            Margin="0,5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Background="{StaticResource Brush.Border.Normal}"
            Opacity="0.5" />
    </Grid>
</UserControl>
